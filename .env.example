# Copy to .env and adjust. Every variable is optional; the defaults are shown.

# Path of the SQLite database file, relative to the working directory.
TICKET_AGENT_DATABASE_PATH=data/tickets.db

# Interface and port the API server listens on.
TICKET_AGENT_HOST=127.0.0.1
TICKET_AGENT_PORT=8000

# Google AI Studio key for Gemini; see the README for how to get one. Read under this
# plain name, without the prefix. Required for any model call.
GEMINI_API_KEY=

# Gemini model id every turn is sent to.
TICKET_AGENT_GEMINI_MODEL_ID=gemini-3.5-flash-lite

# Model calls allowed per request, counting the first; bounds runaway tool use.
TICKET_AGENT_MAX_TOOL_ROUNDS=8

# Port the frontend service listens on (`make frontend` / `make frontend-dev`). The
# frontend forwards /api calls to the backend at TICKET_AGENT_HOST:TICKET_AGENT_PORT.
TICKET_AGENT_FRONTEND_PORT=5173
